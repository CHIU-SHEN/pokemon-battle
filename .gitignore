# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_*/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# IDE and OS-local files
.vscode/
.idea/
.DS_Store
__MACOSX/
._*
Thumbs.db

# Secrets and local authentication
.env
.env.*
!.env.example
kaggle.json
access_token
**/.kaggle/

# Downloaded Kaggle replay payloads (large, reproducible, and redistribution-sensitive)
data/external/kaggle_replays/raw/
data/external/kaggle_replays/download*.log
data/external/kaggle_replays/download_progress.json
data/external/kaggle_replays/restore_progress.json
data/external/kaggle_replays/restore_audit_summary.json

# Generated replay-derived indexes can be rebuilt locally.
# Keep replay_index.json and core_combo_candidates.json intentionally trackable.

# Large derived training datasets are reproducible from tracked summaries and source logs.
data/processed/*.jsonl
data/reanalysis/*.jsonl
data/training/*.jsonl
data/adapter_views/**/*.jsonl

# Local smoke tests and one-off training artifacts must not mix with formal data.
artifacts/dev_smoke/

# Model checkpoints and recovered server bundles are binary experiment outputs.
# Publish selected frozen weights through a Release or model registry, not Git history.
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.ckpt
artifacts/**/*.safetensors
artifacts/**/*.onnx
artifacts/**/*.npz
artifacts/*.zip
artifacts/_server_results_*/
artifacts/adapter_*/
artifacts/top10-adapters-*.tar.gz
artifacts/top10-adapters-*.tar.gz.sha256
artifacts/archive/server-results/**/*.tar.gz
artifacts/archive/server-results/**/*.tar.gz.sha256
artifacts/top2-mcts-complete-results-*.tar.gz
artifacts/top2-mcts-complete-results-*.tar.gz.sha256

# Adapter trainers may write these conventional output roots. Keep lightweight
# configs, sampling views and reviewed reports elsewhere in the repository.
adapter_runs/
adapter_checkpoints/
server_uploads/
server_results/

# Local trainer and profiler state.
runs/
wandb/
lightning_logs/
**/events.out.tfevents.*
*.prof
*.trace.json

# Rebuildable expanded submission directories. Keep the reviewed zip artifact
# itself trackable; its contents are produced by scripts/build_sl0_submission.py.
final_submissions/sl0_shared_stage1/

# All newly generated submission packages are reproducible from source + checkpoint.
# Existing reviewed packages already tracked by Git are unaffected by these rules.
final_submissions/*/
final_submissions/*.zip
final_submissions/*.tar.gz
final_submissions/*.tar.gz.sha256

# Raw Arena output is local and can grow to many thousands of games. Promote only
# compact, reviewed conclusions into reports/.
experiments/**/games.json
experiments/gru_arena_campaign_*/
experiments/gru_vs_sl0_local_*/
experiments/adapter_exact_*/
experiments/adapter_*/
experiments/top2_adapter_smoke/
experiments/top2_adapter_smoke_dev/
experiments/top2_adapter_arena/
experiments/top2_adapter_arena_dev_smoke/
experiments/top2_adapter_playoff/
experiments/top2_adapter_final/
experiments/*.stdout.log
experiments/*.stderr.log

# Failure replays and runtime logs can contain very large observations.
logs/bad_cases/
logs/adapter_exact_*/
logs/adapter_*/
logs/**/*.log
*.stdout.log
*.stderr.log

# Local stage-gate match outputs are summarized in the tracked report.
experiments/sl0_stage1_vs_safe_v0_*/
experiments/safe_v0_vs_sl0_stage1_*/

# Local staging area for GitHub Release assets. Contents may be hard links to
# large generated datasets and must never be added to the normal Git history.
release_assets/

# Reproducible third-party source checkouts
data/external/kaggle_cli_official/
data/external/kagd_pokemon_tcg_battle_replay/
data/external/kaggle_pokemon_tcg_ai_battle/
data/external/ptcg_bench/

# Temporary archives and partial downloads
*.part
*.tmp
*.tar.zst
*.zip.part

# Local Git worktrees
.worktrees/
